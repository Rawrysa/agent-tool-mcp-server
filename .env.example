# Redis (the compose file starts one for you)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=

# Server
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_SERVER_URL=http://localhost:8000
LOG_LEVEL=INFO

# Async jobs
JOB_WORKER_CONCURRENCY=2
JOB_POLL_INTERVAL_SECONDS=5
JOB_POLL_TIMEOUT_SECONDS=1800
DEMO_REPORT_SECONDS=15
